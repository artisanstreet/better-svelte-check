{
  "name": "better-svelte-check",
  "version": "0.1.0",
  "private": true,
  "description": "One-shot Svelte checking through the project's Vite source transforms.",
  "homepage": "https://github.com/artisanstreet/better-svelte-check#readme",
  "bugs": {
    "url": "https://github.com/artisanstreet/better-svelte-check/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artisanstreet/better-svelte-check.git"
  },
  "bin": {
    "better-svelte-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "node build/checker.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node src/cli.ts",
    "test": "node build/checker.ts && vitest run",
    "prepack": "node build/checker.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "effect": "4.0.5",
    "svelte-language-server": "0.18.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.1.0",
    "@types/node": "^24.6.1",
    "magic-string": "^0.30.21",
    "rolldown": "1.1.4",
    "svelte-effect-runtime": "5.0.1",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
